{
  "name": "bookete-crm",
  "version": "1.18.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/web/main.js --bundle --format=esm --minify --outfile=public/app.js",
    "dev": "npm run build && wrangler dev",
    "test": "node --import ./test/workers-stub.js --test --no-warnings=ExperimentalWarning test/*.test.js",
    "deploy": "npm run build && wrangler d1 migrations apply crm --remote && wrangler deploy"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.151.0"
  }
}
